# Local development only. Add your computer's private Wi-Fi IPv4 address.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-replace-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.10

# Local login messages are saved privately in backend/.local-email/.
# Set a verified HTTPS /login URL for the pilot; HTTP is allowed only in DEBUG.
LOGIN_LINK_BASE_URL=http://192.168.1.10:8000/login
# Pilot SMTP: set these in your private .env, never in Git.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=replace-with-provider-username
# EMAIL_HOST_PASSWORD=replace-with-provider-password
# DEFAULT_FROM_EMAIL=Swipe-IQ <login@your-domain.example>
ANDROID_PACKAGE=com.swipeiq.mobile
# Comma-separated SHA-256 signing fingerprints from your installed build.
# ANDROID_CERT_FINGERPRINTS=replace-with-real-fingerprint
